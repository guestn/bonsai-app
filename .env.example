# Firebase Configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Analytics (optional)
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Only this Google account may edit data and upload photos
VITE_AUTHORIZED_EMAIL=you@example.com

# Vercel Blob (server env on Vercel: create a Blob store; BLOB_READ_WRITE_TOKEN is set automatically)
# Optional: when the SPA is not on the same origin as /api (e.g. local Vite + `vercel dev` on another port), set:
# VITE_VERCEL_BLOB_API_BASE=http://localhost:3000

# Development Configuration (optional)
VITE_USE_MOCK_DATA=false
VITE_DEBUG=false
